// 20260509_bank_expansion_15k.slim
//
// Build one demographic-expansion haplotype bank entry. Independent run.
// Adapted from 20260429_bank_independent_15k.slim (the working neutral
// bank script, line-116 patched and smoke-tested 2026-05-09 in job
// 45043183_1).
//
// Locked Panel C design (handoff 2026-05-09):
//   - Instantaneous expansion at T_EXPANSION from K_ANC to K_POST
//   - K_POST = K_NURSES (matches the neutral campaign K)
//   - K_ANC = K_POST / EXPANSION_FACTOR (computed by wrapper)
//   - Expansion factors per design: {10, 100, 1000, 5000}
//
// Mechanism: K_active = (community.tick < T_EXPANSION) ? K_ANC else K_POST.
// The early() callback uses K_active as the carrying-capacity cap when
// gating oozooid maturation. This is the nonWF analog of WF demographic
// models that use setSubpopulationSize directly. Validated in local
// SLiMgui smoke test 2026-05-09 (20260509_expansion_localtest.slim):
// pre-expansion equilibrium 237 vs target 250 (~5% low, normal nonWF
// stochastic offset), post-expansion 2375 vs target 2500 (same offset),
// growth complete within ~100 ticks of T_EXPANSION.
//
// Lifecycle structure (reproduction, early survival, end-tick sample,
// bank writeFile) preserved verbatim from 20260429_bank_independent_15k.slim
// EXCEPT for K_NURSES->K_active in the early() nurse-maturation slots
// calculation.
//
// All numerical parameters come from -d flags. K_ANC is computed by the
// cluster wrapper from K_NURSES and EXPANSION_FACTOR; FACTOR_IDX is used
// for the bank output filename.
//
// Required -d flags: K_NURSES, K_ANC, T_EXPANSION, FACTOR_IDX, MU,
// OOZ_SURVIVAL, NURSE_MORTALITY, COMBO_ID, BANK_RUN_ID, GENOME_LENGTH,
// PHOROS_PER_NURSE, GONOS_PER_PHORO, EGGS_PER_GONO, SELFING_RATE,
// BANK_END_TICK, BANKDIR.

initialize() {
    initializeSLiMModelType("nonWF");

    if (!exists("K_NURSES")) stop("K_NURSES required");
    if (!exists("K_ANC")) stop("K_ANC required");
    if (!exists("T_EXPANSION")) stop("T_EXPANSION required");
    if (!exists("FACTOR_IDX")) stop("FACTOR_IDX required");
    if (!exists("MU")) stop("MU required");
    if (!exists("OOZ_SURVIVAL")) stop("OOZ_SURVIVAL required");
    if (!exists("NURSE_MORTALITY")) stop("NURSE_MORTALITY required");
    if (!exists("COMBO_ID")) stop("COMBO_ID required");
    if (!exists("BANK_RUN_ID")) stop("BANK_RUN_ID required");
    if (!exists("GENOME_LENGTH")) stop("GENOME_LENGTH required");
    if (!exists("PHOROS_PER_NURSE")) stop("PHOROS_PER_NURSE required");
    if (!exists("GONOS_PER_PHORO")) stop("GONOS_PER_PHORO required");
    if (!exists("EGGS_PER_GONO")) stop("EGGS_PER_GONO required");
    if (!exists("SELFING_RATE")) stop("SELFING_RATE required");
    if (!exists("BANK_END_TICK")) stop("BANK_END_TICK required");
    if (!exists("BANKDIR")) stop("BANKDIR required");

    // Sanity check: T_EXPANSION must be strictly between tick 1 and BANK_END_TICK
    if (T_EXPANSION <= 1) stop("T_EXPANSION must be > 1");
    if (T_EXPANSION >= BANK_END_TICK) stop("T_EXPANSION must be < BANK_END_TICK");
    if (K_ANC < 1) stop("K_ANC must be >= 1");
    if (K_ANC > K_NURSES) stop("K_ANC must be <= K_NURSES (post-expansion K)");

    initializeMutationType("m1", 0.5, "f", 0.0);
    m1.mutationStackPolicy = "l";
    m1.convertToSubstitution = F;
    initializeGenomicElementType("g1", m1, 1.0);
    initializeChromosome(1, GENOME_LENGTH, type="H");
    initializeGenomicElement(g1);
    initializeMutationRate(MU);
    initializeRecombinationRate(0.0);

    defineConstant("BANKFILE", BANKDIR + "/bank_expansion_combo" + COMBO_ID +
        "_factor" + FACTOR_IDX + ".tsv");

    catn("combo " + COMBO_ID + " run " + BANK_RUN_ID +
        ": K_anc=" + K_ANC + " K_post=" + K_NURSES +
        " factor_idx=" + FACTOR_IDX +
        " T_exp=" + T_EXPANSION + " end=" + BANK_END_TICK +
        " mu=" + MU);
}

reproduction() {
    if (individual.tag == 1) {
        for (i in seqLen(PHOROS_PER_NURSE)) {
            o = subpop.addCloned(individual);
            if (!isNULL(o)) o.tag = 2;
        }
    }
    if (individual.tag == 2) {
        for (i in seqLen(GONOS_PER_PHORO)) {
            o = subpop.addCloned(individual);
            if (!isNULL(o)) o.tag = 3;
        }
    }
    if (individual.tag == 3) {
        mom = individual.haplosomesNonNull;
        for (i in seqLen(EGGS_PER_GONO)) {
            o = subpop.addRecombinant(mom, NULL, integer(0), NULL, NULL, NULL);
            if (!isNULL(o)) o.tag = 0;
        }
    }
}

1 early() {
    // Founders sized to K_ANC / 10 (matching the neutral script's K/10
    // founder pattern, but at the ancestral scale). Guarded with max(1, .)
    // for the factor=5000 case where K_ANC=5 would give K_ANC/10 = 0.
    sim.addSubpop("p1", max(1, asInteger(K_ANC / 10)));
    p1.individuals.tag = 1;
}

early() {
    if (community.tick == 1) return;

    // Active carrying capacity: ancestral until T_EXPANSION, then post.
    K_active = (community.tick < T_EXPANSION) ? K_ANC else K_NURSES;

    inds = p1.individuals;
    if (size(inds) == 0) {
        catn("extinct at tick " + community.tick);
        community.simulationFinished();
        return;
    }

    ooz = inds[(inds.tag == 0) & (inds.age >= 1)];
    if (size(ooz) > 0) {
        nurses = p1.individuals[p1.individuals.tag == 1];
        slots = K_active - size(nurses);
        ooz = sample(ooz, size(ooz));
        matured = 0;
        for (o in ooz) {
            if (runif(1) < OOZ_SURVIVAL & matured < slots) {
                o.tag = 1;
                matured = matured + 1;
            } else {
                o.fitnessScaling = 0.0;
            }
        }
    }

    nurses = p1.individuals[p1.individuals.tag == 1];
    if (size(nurses) > 0) {
        nKill = asInteger(max(1.0, ceil(size(nurses) * NURSE_MORTALITY)));
        if (nKill > size(nurses)) nKill = size(nurses);
        sample(nurses, nKill).fitnessScaling = 0.0;
    }

    oldP = p1.individuals[(p1.individuals.tag == 2) & (p1.individuals.age >= 1)];
    if (size(oldP) > 0) oldP.fitnessScaling = 0.0;

    oldG = p1.individuals[(p1.individuals.tag == 3) & (p1.individuals.age >= 1)];
    if (size(oldG) > 0) oldG.fitnessScaling = 0.0;
}

BANK_END_TICK late() {
    nurses = p1.individuals[p1.individuals.tag == 1];
    if (size(nurses) < 1) {
        catn("no nurses at tick " + community.tick);
        community.simulationFinished();
        return;
    }

    h = sample(nurses, 1).haplosomesNonNull[0];
    m = h.mutations;
    pos = (size(m) > 0) ? paste(sort(m.position), sep=" ") else "";

    writeFile(BANKFILE, BANK_RUN_ID + "\t" + pos, append=T);
    catn("wrote bank entry " + BANK_RUN_ID + ", " + size(m) + " mutations");
    community.simulationFinished();
}
